# ── Static Web Server — Docker Hardened Image (DHI) for Apache httpd ──────
# Minimal Apache with hardened security, non-root execution
# Uses official httpd but with security modifications

FROM httpd:2.4-alpine

# Install security/monitoring tools
RUN apk add --no-cache ca-certificates curl && \
    # Create non-root appuser for httpd (httpd user already exists, but we'll verify)
    # httpd:httpd is uid 33:33 by default in Alpine, which is fine
    # but we can override the DocumentRoot ownership
    true

# Set production mode
ENV APACHE_RUN_MODE=foreground

# Remove default content
RUN rm -rf /usr/local/apache2/htdocs/*

# Apache configuration: security hardening
RUN echo '\
<Directory /usr/local/apache2/htdocs>\
  Options -Indexes -FollowSymLinks\
  AllowOverride None\
  Require all granted\
</Directory>\
\
<Directory /usr/local/apache2/cgi-bin>\
  AllowOverride None\
  Options None\
  Require all denied\
</Directory>\
\
ServerSignature Off\
ServerTokens Prod\
Timeout 30\
' >> /usr/local/apache2/conf/httpd.conf

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl --fail http://localhost:80/index.html || exit 1

EXPOSE 80

# Run as httpd user (uid 33:33, non-root)
USER httpd:httpd

ENTRYPOINT ["httpd-foreground"]
