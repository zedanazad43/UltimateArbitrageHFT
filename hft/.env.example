# ── CEX API credentials ──────────────────────────────────────────────────────
# At least one pair (MEXC or Binance) is required for live trading.
# Full variable reference: see docs/env-reference.md (section 3)
MEXC_API_KEY=
MEXC_API_SECRET=

BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

KUCOIN_API_KEY=
KUCOIN_SECRET_KEY=
KUCOIN_PASSPHRASE=

# ── EVM / on-chain ───────────────────────────────────────────────────────────
# Private key (hex, no 0x prefix) of the wallet that signs DEX transactions.
WALLET_PRIVATE_KEY=

# Primary Ethereum RPC endpoint.
# Using rpc.flashbots.net routes txs privately without extra code changes.
ETH_RPC_URL=https://rpc.flashbots.net

# Arbitrum One RPC (preferred for DEX arb — gas is 10-20x cheaper than mainnet).
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Flashbots relay endpoint.
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# Separate key used ONLY to sign Flashbots bundle requests (no ETH needed).
FLASHBOTS_SIGNING_KEY=

# ── Price APIs ───────────────────────────────────────────────────────────────
# Alchemy API key for on-chain price fetching and ETH RPC.
ALCHEMY_API_KEY=

# 0x API key for DEX price quotes.
ZEROX_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL DSN for trade logging.
POSTGRES_DSN=postgres://hft:hft@localhost:5432/hft?sslmode=disable

# ── Telegram alerts ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading parameters ───────────────────────────────────────────────────────
# PAPER_TRADING=true means no real orders are placed (safe default).
PAPER_TRADING=true
# TRADING_ENABLED must also be true to place any order.
TRADING_ENABLED=false

INITIAL_CAPITAL_USD=1000
MAX_DAILY_LOSS_USD=25
MIN_SECONDS_BETWEEN_TX=30
MAX_PER_TRADE_LOSS_PCT=0.02
MAX_SPREAD_PCT=5.0
WIN_RATE=0.55
RISK_REWARD_RATIO=2.0

# ── Engine tuning ────────────────────────────────────────────────────────────
# How often to evaluate the price book for opportunities (milliseconds).
SCAN_INTERVAL_MS=500

# Skip a DEX trade when estimated gas cost > this fraction of expected profit.
MAX_GAS_COST_PCT=0.30

# Minimum net profit to execute a trade (%).
MIN_NET_PROFIT_PCT=0.05

# Prometheus metrics HTTP listen address.
METRICS_ADDR=:9090
