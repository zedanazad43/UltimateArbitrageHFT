{
  "name": "ultimate-arbitrage-hft",
  "version": "2.0.0",
  "description": "Unified Arbitrage Hub - Real Trading Engine",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.mjs,.cjs",
    "build:check": "wrangler deploy --dry-run",
    "verify:prod": "npm run lint && npm run test:all && npm run build:check",
    "preflight:prod": "npm run verify:prod && npm run check:secrets",
    "ready:prod": "npm run preflight:prod && npm run validate:production",
    "build": "wrangler deploy",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:local-ai": "AI_BACKEND=local LOCAL_AI_ENDPOINT=http://127.0.0.1:8000 wrangler dev --local",
    "ai:gateway:start": "python3 codegeex-server.py",
    "ai:gateway:health": "python3 check-codegeex-health.py",
    "ai:local:all": "bash -lc 'nohup python3 codegeex-server.py >/tmp/codegeex-gateway.log 2>&1 & sleep 2; python3 check-codegeex-health.py; CODEGEEX_ENDPOINT=http://127.0.0.1:8000 CODEGEEX_MODEL=codegeex4 node test-ide-integration.js; AI_BACKEND=local LOCAL_AI_ENDPOINT=http://127.0.0.1:8000 npx wrangler dev --local'",
    "tail": "wrangler tail",
    "test": "node --test tests/unit.test.js",
    "test:integration": "node --test tests/exchange.integration.test.js",
    "test:prices": "node --test tests/prices.test.js",
    "test:exchange": "node --test tests/exchange-multi.test.js",
    "test:notifier": "node --test tests/notifier.test.js",
    "test:dex": "node --test tests/dex.test.js",
    "test:hft": "node --test tests/hft-client.test.js",
    "test:ai": "node --test tests/ai-client.test.js",
    "test:db": "node --test tests/db-schema-init.test.js",
    "test:security": "node --test tests/security-auth.test.js",
    "test:self-eval": "node --test tests/self-evaluation.test.js",
    "test:ide": "node test-ide-integration.js",
    "test:ide:local": "CODEGEEX_ENDPOINT=http://127.0.0.1:8000 CODEGEEX_MODEL=codegeex4 node test-ide-integration.js",
    "test:all": "node --test tests/unit.test.js tests/exchange.integration.test.js tests/prices.test.js tests/exchange-multi.test.js tests/notifier.test.js tests/dex.test.js tests/hft-client.test.js tests/ai-client.test.js tests/db-schema-init.test.js tests/exchange-fill-metrics.test.js tests/security-auth.test.js tests/dashboard-api-wiring.test.js tests/platforms-api.test.js tests/self-evaluation.test.js tests/proxy-pool.test.js tests/auto-executor.test.js tests/bot-memory.test.js tests/orchestrator.atomic.test.js tests/safety-lock.test.js",
    "monitor": "node scripts/monitor-performance.js",
    "monitor:spot-lock": "node scripts/monitor-spot-lock.js",
    "monitor:exec": "node scripts/monitor-exec-stability.js --interval-ms 300000 --samples 6 --run-execute-all true",
    "monitor:exec:quick": "node scripts/monitor-exec-stability.js --interval-ms 5000 --samples 3 --run-execute-all true",
    "monitor:critical": "node scripts/monitor-live-critical.js --samples 288 --interval-ms 300000 --auto-stop true",
    "monitor:critical:dry": "node scripts/monitor-live-critical.js --samples 12 --interval-ms 60000 --auto-stop false",
    "diagnose:exchanges": "node scripts/diagnose-exchange-readiness.js",
    "activate:live": "node scripts/activate-live-trading.js",
    "activate:live:fast": "node scripts/activate-live-trading.js --profile turbo",
    "activate:live:fast:dry": "node scripts/activate-live-trading.js --profile turbo --dry-run",
    "proxy001": "node scripts/proxy001-helper.js",
    "proxy001:sync": "node scripts/proxy001-sync-deploy.js",
    "remediate:exchanges": "pwsh -NoProfile -File ./scripts/remediate-all-exchanges.ps1",
    "self:evaluate": "node scripts/self-evaluate-strategies.js",
    "backup": "pwsh -NoProfile -File ./scripts/backup-database.ps1",
    "backup:full": "pwsh -NoProfile -File ./scripts/backup-database.ps1 -Full",
    "check:secrets": "node scripts/security-audit.js --secrets-only",
    "scan:secrets": "node scripts/secret-scan.js",
    "refresh:bitget-fallback": "node scripts/refresh-bitget-fallback.js",
    "check:symbol-catalog": "node scripts/check-symbol-catalog.js",
    "check:static": "node scripts/static-check.js",
    "verify:all": "npm run scan:secrets && npm run check:static && npm run test:all",
    "audit:security": "node scripts/security-audit.js --with-audit",
    "validate:production": "npm run lint && npm run test:all && npm run check:secrets && npm run build:check && npm run monitor",
    "smoke:prod": "node scripts/verify-production-endpoints.js",
    "smoke:prod:custom": "node scripts/verify-production-endpoints.js",
    "smoke:safety-lock": "node scripts/verify-safety-lock.js --enforce-lock",
    "smoke:lock-block": "node scripts/verify-lock-block.js",
    "smoke:core-flags": "node scripts/verify-core-flags-stability.js",
    "smoke:all-guards": "npm run smoke:prod && npm run smoke:safety-lock && npm run smoke:lock-block",
    "smoke:prod:paper": "pwsh -NoProfile -File ./scripts/run-smoke.ps1",
    "smoke:prod:live": "pwsh -NoProfile -File ./scripts/run-smoke.ps1 -RequireReadyForLive",
    "check:connection": "node scripts/check-connection.js",
    "netfix:start": "pwsh -NoProfile -File ./scripts/start-bitget-network-fix.ps1",
    "netfix:stop": "pwsh -NoProfile -File ./scripts/stop-bitget-network-fix.ps1",
    "db:migrate": "wrangler d1 execute ultimate-arbitrage-db --remote --file=./migrations/schema.sql",
    "db:migrate:local": "wrangler d1 execute ultimate-arbitrage-db --local --file=./migrations/schema.sql",
    "secret:all": "pwsh -NoProfile -File ./scripts/upload-secrets.ps1",
    "secret:dry": "pwsh -NoProfile -File ./scripts/upload-secrets.ps1 -DryRun",
    "secret:postcheck": "node scripts/post-secret-sync-check.js",
    "temporal:worker": "node temporal-worker.js",
    "temporal:dev": "TEMPORAL_ADDRESS=localhost:7233 node temporal-worker.js",
    "setup": "npm install && npm run secret:all && npm run db:migrate && npm run deploy",
    "setup:local": "npm install && npm run db:migrate:local",
    "profile:direct": "bash scripts/switch-profile.sh direct",
    "profile:mixed": "bash scripts/switch-profile.sh mixed",
    "profile:strict": "bash scripts/switch-profile.sh strict",
    "profile:dry": "bash scripts/switch-profile.sh"
  },
  "dependencies": {
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.46",
    "@temporalio/activity": "^1.12.3",
    "@temporalio/client": "^1.16.1",
    "@temporalio/worker": "^1.4.4",
    "@temporalio/workflow": "^1.16.1",
    "dotenv": "^16.6.1",
    "hono": "^4.12.18",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.35.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "talisman": "^1.1.4",
    "wrangler": "^4.87.0"
  },
  "overrides": {
    "jsonwebtoken": "^9.0.3",
    "ws": ">=8.20.2"
  },
  "overrides": {
    "protobufjs": "^7.5.6",
    "ws": "8.20.1",
    "brace-expansion": "5.0.6"
  }
}