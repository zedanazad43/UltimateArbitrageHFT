# Docker build context exclusions — for simple API + Web stack

# Version control
.git
.gitignore
.gitattributes

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build artifacts
dist/
build/
.out/
*.o
*.a

# Environment & secrets
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
private/

# IDE & editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
jest_cache/
.mocha_cache/

# Docker files (in dockerfile, not needed in context)
Dockerfile
Dockerfile.dhi
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Documentation
docs/
README.md
*.md

# Temporary files
tmp/
temp/
*.tmp
*.bak

# OS
.AppleDouble
.LSOverride

# Project-specific
node_modules/.cache/
.turbo/
.next/

# Keep only essential files
!packages/api/src/
!packages/api/package.json
!packages/api/*.js
!packages/web/
