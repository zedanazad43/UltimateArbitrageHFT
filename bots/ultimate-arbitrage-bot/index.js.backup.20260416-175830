// ============================================================
// ARBITRAGE BOT v5.1 - MEXC ↔ BITGET (CORRECTED API)
// ============================================================
const INITIAL_TRADE_SIZE = 10;
const GROWTH_FACTOR = 3.5;
const MIN_PROFIT_PERCENT = 0.05;
const REBALANCE_INTERVAL = 3 * 60 * 60 * 1000;
const PAPER_TRADING = false;
let botRunning = true;

let botState = {
    tradeSize: INITIAL_TRADE_SIZE,
    totalProfitUSD: 0,
    dailyProfitUSD: 0,
    totalTrades: 0,
    tradeCount: 0,
    lastDate: new Date().toDateString(),
    lastRebalance: Date.now(),
    history: []
};

// ========== دوال مساعدة ==========
async function fetchWithRetry(url, options = {}, retries = 2) {
    for (let i = 0; i <= retries; i++) {
        try {
            const response = await fetch(url, options);
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return await response.json();
        } catch (err) {
            if (i === retries) throw err;
            await new Promise(r => setTimeout(r, 1000 * (i+1)));
        }
    }
}

async function hmacSha256(message, secret) {
    const encoder = new TextEncoder();
    const keyData = encoder.encode(secret);
    const messageData = encoder.encode(message);
    const cryptoKey = await crypto.subtle.importKey('raw', keyData, { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
    const signature = await crypto.subtle.sign('HMAC', cryptoKey, messageData);
    return Array.from(new Uint8Array(signature)).map(b => b.toString(16).padStart(2, '0')).join('');
}

function roundQuantity(qty) {
    return Math.floor(qty * 1e6) / 1e6;
}

// ========== جلب الأسعار (باستخدام endpoints صحيحة) ==========
const getMEXC = async () => {
    const data = await fetchWithRetry('https://api.mexc.com/api/v3/ticker/price?symbol=BTCUSDT');
    return data?.price ? parseFloat(data.price) : null;
};

const getBitget = async () => {
    // Bitget endpoint الصحيح (مع tickers الجمع)
    const data = await fetchWithRetry('https://api.bitget.com/api/v2/spot/market/tickers?symbol=BTCUSDT');
    return data?.data?.[0]?.last ? parseFloat(data.data[0].last) : null;
};

// ========== تنفيذ الأوامر ==========
async function mexcOrder(side, quantity, env) {
    const apiKey = env.MEXC_API_KEY;
    const secret = env.MEXC_API_SECRET;
    const rounded = roundQuantity(quantity);
    if (rounded <= 0) throw new Error('Quantity too small');
    const timestamp = Date.now();
    const params = new URLSearchParams({ symbol: 'BTCUSDT', side: side.toUpperCase(), type: 'MARKET', quantity: rounded.toString(), timestamp: timestamp.toString() });
    const signature = await hmacSha256(params.toString(), secret);
    const url = `https://api.mexc.com/api/v3/order?${params}&signature=${signature}`;
    const response = await fetch(url, { method: 'POST', headers: { 'X-MEXC-APIKEY': apiKey } });
    const data = await response.json();
    if (!response.ok) throw new Error(`MEXC ${side} failed: ${JSON.stringify(data)}`);
    console.log(`✅ MEXC ${side.toUpperCase()} ${rounded} BTC`);
    return data;
}

async function bitgetOrder(side, quantity, env) {
    const apiKey = env.BITGET_API_KEY;
    const secret = env.BITGET_API_SECRET;
    const passphrase = env.BITGET_PASSPHRASE;
    const timestamp = Date.now();
    const method = 'POST';
    const requestPath = '/api/v2/spot/trade/orders';
    const body = JSON.stringify({ symbol: 'BTCUSDT', side: side.toLowerCase(), orderType: 'market', size: quantity.toString(), clientOid: Date.now().toString() });
    const signStr = timestamp + method + requestPath + body;
    const signature = await hmacSha256(signStr, secret);
    const url = `https://api.bitget.com${requestPath}`;
    const response = await fetch(url, {
        method: 'POST',
        headers: {
            'ACCESS-KEY': apiKey,
            'ACCESS-SIGN': signature,
            'ACCESS-TIMESTAMP': timestamp.toString(),
            'ACCESS-PASSPHRASE': passphrase || '',
            'Content-Type': 'application/json'
        },
        body
    });
    const data = await response.json();
    if (data.code !== '00000') throw new Error(`Bitget ${side} failed: ${JSON.stringify(data)}`);
    console.log(`✅ Bitget ${side.toUpperCase()} ${quantity} BTC`);
    return data;
}

// ========== تحديث الحالة ==========
async function updateState(profit, env) {
    const today = new Date().toDateString();
    if (botState.lastDate !== today) {
        botState.dailyProfitUSD = 0;
        botState.lastDate = today;
    }
    botState.totalProfitUSD += profit;
    botState.dailyProfitUSD += profit;
    botState.totalTrades++;
    botState.tradeCount++;
    if (botState.tradeCount % 10 === 0) {
        botState.tradeSize = Math.min(botState.tradeSize * GROWTH_FACTOR, 500);
    }
    botState.history.unshift({ time: new Date().toISOString(), profit: profit.toFixed(2) });
    if (botState.history.length > 50) botState.history.pop();
    await env.BOT_STATE.put('bot_state', JSON.stringify(botState));
    console.log(`💰 Profit: $${profit.toFixed(2)} | Total: $${botState.totalProfitUSD.toFixed(2)}`);
}

// ========== دورة المراجحة ==========
async function runCycle(env) {
    const saved = await env.BOT_STATE.get('bot_state', 'json');
    if (saved) botState = { ...botState, ...saved };
    if (!botRunning) return;

    const mexcPrice = await getMEXC();
    const bitgetPrice = await getBitget();
    if (!mexcPrice || !bitgetPrice) {
        console.log('⚠️ فشل في جلب الأسعار');
        return;
    }

    // تحديد الاتجاه
    let buyExchange, sellExchange, buyPrice, sellPrice;
    if (mexcPrice < bitgetPrice) {
        buyExchange = 'MEXC'; buyPrice = mexcPrice;
        sellExchange = 'Bitget'; sellPrice = bitgetPrice;
    } else if (bitgetPrice < mexcPrice) {
        buyExchange = 'Bitget'; buyPrice = bitgetPrice;
        sellExchange = 'MEXC'; sellPrice = mexcPrice;
    } else {
        return;
    }

    const profitPct = ((sellPrice - buyPrice) / buyPrice) * 100;
    if (profitPct < MIN_PROFIT_PERCENT) return;

    console.log(`🎯 فرصة: شراء من ${buyExchange} بسعر ${buyPrice} وبيع في ${sellExchange} بسعر ${sellPrice} – ربح متوقع ${profitPct.toFixed(3)}%`);
    const quantity = botState.tradeSize / buyPrice;
    const roundedQty = roundQuantity(quantity);
    if (roundedQty <= 0) return;

    if (!PAPER_TRADING) {
        if (buyExchange === 'MEXC') await mexcOrder('buy', roundedQty, env);
        else await bitgetOrder('buy', roundedQty, env);
        if (sellExchange === 'MEXC') await mexcOrder('sell', roundedQty, env);
        else await bitgetOrder('sell', roundedQty, env);
        const profit = (profitPct / 100) * botState.tradeSize;
        await updateState(profit, env);
    } else {
        console.log(`🔸 [PAPER] ربح: $${(profitPct / 100) * botState.tradeSize}`);
    }
}

// ========== لوحة التحكم ==========
function renderDashboard(state) {
    return `<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><title>بوت المراجحة MEXC ↔ Bitget</title><style>body{background:#0f0c29;color:#fff;font-family:system-ui;text-align:center;padding:20px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin:20px 0}.stat-box{background:rgba(0,0,0,0.3);padding:15px;border-radius:10px}.stat-value{font-size:28px;font-weight:bold;color:#00cec9}button{background:#00b894;border:none;color:#fff;padding:10px 20px;margin:5px;border-radius:8px;cursor:pointer}.stop{background:#d63031}</style></head><body><div><h1>🤖 بوت المراجحة MEXC ↔ Bitget</h1><div><button onclick="fetch('/control',{method:'POST',body:'start'}).then(()=>location.reload())">▶️ تشغيل</button><button onclick="fetch('/control',{method:'POST',body:'stop'}).then(()=>location.reload())" class="stop">⏹️ إيقاف</button></div><div class="stats"><div class="stat-box"><div class="stat-value">${state.totalTrades||0}</div><div>الصفقات</div></div><div class="stat-box"><div class="stat-value">$${(state.totalProfitUSD||0).toFixed(2)}</div><div>الربح</div></div><div class="stat-box"><div class="stat-value">$${(state.dailyProfitUSD||0).toFixed(2)}</div><div>ربح اليوم</div></div><div class="stat-box"><div class="stat-value">$${state.tradeSize.toFixed(2)}</div><div>حجم الصفقة</div></div></div><h3>📜 آخر الصفقات</h3><ul>${state.history.slice(0,10).map(t=>`<li>${new Date(t.time).toLocaleString()}: $${t.profit}</li>`).join('')}</ul></div></body></html>`;
}

export default {
    async scheduled(event, env, ctx) { if (botRunning) await runCycle(env); },
    async fetch(request, env, ctx) {
        const saved = await env.BOT_STATE.get('bot_state', 'json');
        if (saved) botState = { ...botState, ...saved };
        const url = new URL(request.url);
        if (url.pathname === '/' || url.pathname === '/dashboard') return new Response(renderDashboard(botState), { headers: { 'Content-Type': 'text/html; charset=UTF-8' } });
        if (url.pathname === '/control' && request.method === 'POST') { const body = await request.text(); botRunning = (body === 'start'); return new Response("OK"); }
        return new Response("استخدم /dashboard");
    }
};