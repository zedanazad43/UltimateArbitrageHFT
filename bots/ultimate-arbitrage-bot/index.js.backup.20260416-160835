async function findArbitrageOpportunity() {
    let best = null;
    const exchanges = ['MEXC', 'Binance', 'KuCoin', 'Bitmart'];
    for (const asset of assets) {
        const prices = {};
        for (const ex of exchanges) {
            if (ex === 'MEXC') prices[ex] = await getMEXC(asset);
            else if (ex === 'Binance') prices[ex] = await getBinance(asset);
            else if (ex === 'KuCoin') prices[ex] = await getKuCoin(asset);
            else if (ex === 'Bitmart') prices[ex] = await getBitmart(asset);
            if (!prices[ex]) delete prices[ex];
        }
        const entries = Object.entries(prices);
        for (let i = 0; i < entries.length; i++) {
            for (let j = i+1; j < entries.length; j++) {
                const [buyEx, buyPrice] = entries[i];
                const [sellEx, sellPrice] = entries[j];
                if (buyPrice && sellPrice) {
                    const buy = Math.min(buyPrice, sellPrice);
                    const sell = Math.max(buyPrice, sellPrice);
                    const profitPct = ((sell - buy) / buy) * 100;
                    if (profitPct > MIN_PROFIT_PERCENT) {
                        const profitUSD = (profitPct / 100) * botState.tradeSize;
                        if (!best || profitUSD > best.profitUSD) {
                            best = { type: 'ARBITRAGE', asset, buyExchange: buyPrice < sellPrice ? buyEx : sellEx, buyPrice: buy, sellExchange: buyPrice > sellPrice ? buyEx : sellEx, sellPrice: sell, profitPct, profitUSD };
                        }
                    }
                }
            }
        }
    }
    return best;
}

let priceHistory = { BTC: [], ETH: [], SOL: [], XRP: [], DOGE: [] };
const SCALP_THRESHOLD = 0.15;
const SCALP_WINDOW = 5;

async function checkScalping(asset, currentPrice) {
    const history = priceHistory[asset];
    history.push({ price: currentPrice, time: Date.now() });
    if (history.length > SCALP_WINDOW) history.shift();
    if (history.length < SCALP_WINDOW) return null;
    const first = history[0].price;
    const last = currentPrice;
    const changePct = ((last - first) / first) * 100;
    if (Math.abs(changePct) >= SCALP_THRESHOLD) {
        const side = changePct > 0 ? 'sell' : 'buy';
        const profitPct = Math.abs(changePct);
        const profitUSD = (profitPct / 100) * botState.tradeSize;
        return { type: 'SCALPING', asset, side, profitPct, profitUSD };
    }
    return null;
}

