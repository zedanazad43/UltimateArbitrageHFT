# ============================================================
# Cloudflare Worker — local development secrets template
# ============================================================
# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored and MUST NEVER be committed.
#
# Usage:
#   cp .dev.vars.example .dev.vars
#   # edit .dev.vars with your credentials
#   npm run db:migrate:local   # seed local D1 database
#   npm run dev                # start wrangler dev server
# ============================================================

# ── Admin ────────────────────────────────────────────────────
# Arbitrary secret used in the x-admin-token header to protect
# admin routes (/start, /stop, /scan, /config, etc.).
ADMIN_TOKEN=change-me-local-dev

# ── Telegram notifications ───────────────────────────────────
# Bot token from @BotFather and your chat/channel ID.
# Leave blank to disable Telegram alerts during local dev.
# ── MEXC ─────────────────────────────────────────────────────
MEXC_API_KEY=
MEXC_API_SECRET=

# ── Binance ──────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── KuCoin ───────────────────────────────────────────────────
# Canonical names (recommended):
KUCOIN_API_KEY=
KUCOIN_SECRET_KEY=
KUCOIN_PASSPHRASE=
# Alias also accepted for the secret:  KUCOIN_API_SECRET=

# ── Bitget ───────────────────────────────────────────────────
# Canonical names (recommended):
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_API_PASSPHRASE=
# Alias also accepted for the secret:  BITGET_API_SECRET=

# ── Bitmart ──────────────────────────────────────────────────
# Canonical names (recommended):
BITMART_API_KEY=
BITMART_SECRET_KEY=
BITMART_MEMO=
# Alias also accepted for the secret:  BITMART_API_SECRET=

# ── Proxy routing mode ─────────────────────────────────────
# PROXY_MODE values:
#   auto     -> use proxy when configured, fallback direct on failure
#   off      -> always direct (good for servers outside proxy)
#   required -> fail requests if proxy is unavailable
PROXY_MODE=auto
# Optional: exchanges that should always bypass proxy in auto mode.
# Example: DIRECT_EXCHANGES=bitmart,mexc
DIRECT_EXCHANGES=

# ── GitHub Models AI ─────────────────────────────────────────
# Personal Access Token (classic) or fine-grained PAT used to call
# https://models.github.ai/inference with openai/gpt-4.1.
# Grant: read:packages (classic PAT) — no extra scopes needed for GitHub Models.
# When set, /api/ai-analysis uses GitHub Models; otherwise falls back to
# Cloudflare Workers AI (AIWORKER binding).
# Production: `npx wrangler secret put GITHUB_TOKEN`
GITHUB_TOKEN=

# ── Temporal Cloud ────────────────────────────────────────────
# Temporal orchestrates durable trading sessions that survive
# crashes and Cloudflare Worker restarts.
#
# Get your API key at: https://cloud.temporal.io/ → Settings → API Keys
#
# TEMPORAL_API_KEY    — Cloud API key (sensitive; never commit)
# TEMPORAL_ADDRESS    — gRPC endpoint for your namespace, e.g.:
#                         default.abc123.tmprl.cloud:7233
#                       Leave blank to use a local dev server (localhost:7233)
# TEMPORAL_NAMESPACE  — Temporal namespace name (default: "default")
# TEMPORAL_WORKER_URL — Public URL of this Cloudflare Worker.
#                       The Temporal worker process calls /scan on this URL.
#                       Use http://localhost:8787 for local wrangler dev.
TEMPORAL_API_KEY=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_WORKER_URL=http://localhost:8787
