# .dev.vars — Cloudflare Workers Local Development Variables
# Copy this file to .dev.vars and fill in your values.
# WARNING: .dev.vars MUST be in .gitignore — never commit secrets!

# ── Admin & Security ────────────────────────────────────────────────────────────
ADMIN_TOKEN=your-admin-token-here
WORKFLOW_ADMIN_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Telegram Notifications ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Exchange API Credentials ────────────────────────────────────────────────────
# MEXC (spot + futures)
MEXC_API_KEY=
MEXC_API_SECRET=
# MEXC secondary (optional fallback)
MEXC_API_KEY_2=
MEXC_API_SECRET_2=

# Binance spot
BINANCE_API_KEY=
BINANCE_API_SECRET=

# KuCoin spot
KUCOIN_API_KEY=
KUCOIN_SECRET_KEY=
KUCOIN_PASSPHRASE=

# Bitget spot
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_API_PASSPHRASE=

# Bitmart spot
BITMART_API_KEY=
BITMART_SECRET_KEY=
BITMART_MEMO=

# HTX (Huobi) spot
HTX_API_KEY=
HTX_API_SECRET=

# ── Bybit / Gate.io (DATA-ONLY — German regulatory restrictions) ────────────────
# These are used ONLY for public price feeds, never for execution.
BYBIT_API_KEY=
BYBIT_API_SECRET=
GATEIO_API_KEY=
GATEIO_API_SECRET=

# ── Trading Configuration ───────────────────────────────────────────────────────
STRATEGY_MODE=multi_exchange
AGGRESSIVE_SCAN_MODE=on
CEX_MIN_SAFETY_FACTOR=0.10
PERPS_MIN_SAFETY_FACTOR=0.10
CEX_SLIPPAGE_MULTIPLIER=0.40

# ── Execution Exchange Allowlist ────────────────────────────────────────────────
EXECUTION_EXCHANGES_ALLOWLIST=mexc,binance

# ── D1 Database ─────────────────────────────────────────────────────────────────
# Local D1 is created automatically with: npx wrangler d1 execute ultimate-arbitrage-db --local --file=./migrations/schema.sql

# ── R2 Bucket ───────────────────────────────────────────────────────────────────
# Local R2 is simulated; no separate setup needed for dev.

# ── KV Namespace ────────────────────────────────────────────────────────────────
# Local KV is simulated; no separate setup needed for dev.

# ── Workers AI ──────────────────────────────────────────────────────────────────
LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_GATEWAY_ID=
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=

# ── HFT Engine (Go) ─────────────────────────────────────────────────────────────
HFT_ENGINE_URL=
HFT_ENGINE_SECRET=

# ── DEX / On-chain ──────────────────────────────────────────────────────────────
ALCHEMY_API_KEY=
DEX_EXECUTOR_URL=
DEX_EXECUTOR_TOKEN=
DEX_EXECUTION_TIMEOUT_MS=20000
DEX_EXECUTOR_MAX_RETRIES=2
DEX_MAX_SLIPPAGE_BPS=80

# ── Cloudflare Web3 Gateways ────────────────────────────────────────────────────
# Optional: HTTP-accessible Web3 gateways via Cloudflare (no RPC node required)
# If set, these will be used instead of direct RPC endpoints.
# Create gateways at: https://dash.cloudflare.com/?to=/:account/web3/gateways
CLOUDFLARE_GATEWAY_ETH=https://eth-rpc.ecostamp.net
CLOUDFLARE_GATEWAY_ARB=https://arb-rpc.ecostamp.net
CLOUDFLARE_GATEWAY_BSC=https://bsc-rpc.ecostamp.net
CLOUDFLARE_GATEWAY_IPFS=https://ipfs-gateway.ecostamp.net

# Fallback: Direct RPC endpoints (used if Cloudflare gateways not configured)
ETH_RPC_URL=https://rpc.flashbots.net
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BSC_RPC_URL=https://bsc-dataseed.binance.org/rpc

# ── External Proxy ──────────────────────────────────────────────────────────────
PROXY_MODE=auto
PROXY_URL=
PROXY_LIST=

# ── Temporal Cloud ──────────────────────────────────────────────────────────────
TEMPORAL_NAMESPACE=default
TEMPORAL_ADDRESS=
TEMPORAL_WORKER_URL=http://localhost:8787
TEMPORAL_API_KEY=

# ── Ecosystem Integrations ──────────────────────────────────────────────────────
HUMMINGBOT_EXECUTE_URL=
HUMMINGBOT_API_TOKEN=
FREQTRADE_EXECUTE_URL=
FREQTRADE_API_TOKEN=
CREWAI_EXECUTE_URL=
CREWAI_API_TOKEN=
AUTOGPT_EXECUTE_URL=
AUTOGPT_API_TOKEN=

# ── Free Data Providers (optional) ──────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# ── Broker Adapters ─────────────────────────────────────────────────────────────
# Supported: alpaca, ibkr, tradier
BROKER_ALPACA_API_KEY=
BROKER_ALPACA_API_SECRET=
BROKER_IBKR_ACCOUNT_ID=
BROKER_IBKR_GATEWAY_URL=
BROKER_TRADIER_API_TOKEN=
BROKER_TRADIER_ACCOUNT_ID=
