# .dev.vars — Cloudflare Workers Local Development Variables
# Copy this file to .dev.vars and fill in your values.
# WARNING: .dev.vars MUST be in .gitignore — never commit secrets!
#
# For the full variable reference (owner, canonical names, aliases, required/optional)
# see: docs/env-reference.md

# ── Admin & Security ────────────────────────────────────────────────────────────
ADMIN_TOKEN=your-admin-token-here
WORKFLOW_ADMIN_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Telegram Notifications ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Exchange API Credentials ────────────────────────────────────────────────────
# MEXC (spot + futures)
MEXC_API_KEY=
MEXC_API_SECRET=
# MEXC secondary (optional fallback)
MEXC_API_KEY_2=
MEXC_API_SECRET_2=

# Binance spot
BINANCE_API_KEY=
BINANCE_API_SECRET=

# KuCoin spot
KUCOIN_API_KEY=
KUCOIN_SECRET_KEY=
KUCOIN_PASSPHRASE=

# Bitget spot
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_API_PASSPHRASE=

# Bitmart spot
BITMART_API_KEY=
BITMART_SECRET_KEY=
BITMART_MEMO=

# HTX (Huobi) spot
HTX_API_KEY=
HTX_API_SECRET=

# ── Bybit / Gate.io (DATA-ONLY — German regulatory restrictions) ────────────────
# These are used ONLY for public price feeds, never for execution.
BYBIT_API_KEY=
BYBIT_API_SECRET=
GATEIO_API_KEY=
GATEIO_API_SECRET=

# ── Trading Configuration ───────────────────────────────────────────────────────
STRATEGY_MODE=multi_exchange
AGGRESSIVE_SCAN_MODE=on
CEX_MIN_SAFETY_FACTOR=0.10
PERPS_MIN_SAFETY_FACTOR=0.10
CEX_SLIPPAGE_MULTIPLIER=0.40
EXPOSURE_BOOST_MULTIPLIER=1.50
VENUE_READY_PRIORITY_MULTIPLIER=1.45
SPOT_ONLY_LOCK_FORCE=false
MANUAL_RISK_LOCK_FORCE=false
SKIP_BALANCE_CHECK=true
MAX_DAILY_LOSS_USD=25
LIVE_EXECUTION_MIN_BALANCE_USD=0

# ── Forced aggressive execution overrides (set AGGRESSIVE_EXECUTION_FORCE=on to activate) ─
AGGRESSIVE_EXECUTION_FORCE=off
AGGRESSIVE_FORCED_POSITION_SIZE_USD=15
AGGRESSIVE_FORCED_MAX_LIVE_TRADES_PER_SCAN=10
AGGRESSIVE_FORCED_SCALP_MIN_NET_PCT=0.05
AGGRESSIVE_FORCED_MIN_SECONDS_BETWEEN_TRADES=10
AGGRESSIVE_FORCED_SUPPORTED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,ADAUSDT,DOGEUSDT,LTCUSDT,TRXUSDT,LINKUSDT,AVAXUSDT,DOTUSDT

# ── Execution Exchange Allowlist ────────────────────────────────────────────────
EXECUTION_EXCHANGES_ALLOWLIST=mexc,binance

# ── Backtesting ─────────────────────────────────────────────────────────────────
BACKTEST_AUTO_ENABLED=true
BACKTEST_AUTO_INTERVAL_HOURS=24

# ── D1 Database ─────────────────────────────────────────────────────────────────
# Local D1 is created automatically with: npx wrangler d1 execute ultimate-arbitrage-db --local --file=./migrations/schema.sql

# ── R2 Bucket ───────────────────────────────────────────────────────────────────
# Local R2 is simulated; no separate setup needed for dev.

# ── KV Namespace ────────────────────────────────────────────────────────────────
# Local KV is simulated; no separate setup needed for dev.

# ── Workers AI ──────────────────────────────────────────────────────────────────
LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_GATEWAY_ID=
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
AI_FILTER_ENABLED=true
AI_FILTER_MIN_CONFIDENCE=0.7

# ── HFT Engine (Go) ─────────────────────────────────────────────────────────────
HFT_ENGINE_URL=
HFT_ENGINE_SECRET=

# ── DEX / On-chain ──────────────────────────────────────────────────────────────
ALCHEMY_API_KEY=
ALCHEMY_EVM_WALLET=
ALCHEMY_SOLANA_WALLET=
DEX_EXECUTOR_URL=
DEX_EXECUTOR_TOKEN=
DEX_EXECUTION_TIMEOUT_MS=20000
DEX_EXECUTOR_MAX_RETRIES=2
DEX_MAX_SLIPPAGE_BPS=80
DEX_MULTI_CHAIN_ENABLED=true
DEX_CHAINS=ethereum,polygon,arbitrum,optimism,bsc
ONEINCH_API_KEY=
ONEINCH_API=

# ── Cloudflare Web3 Gateways ────────────────────────────────────────────────────
# Optional: HTTP-accessible Web3 gateways via Cloudflare (no RPC node required)
# RPC preference chain: Cloudflare → Alchemy → Direct RPC
# Create gateways at: https://dash.cloudflare.com/?to=/:account/web3/gateways
CLOUDFLARE_GATEWAY_ETH=
CLOUDFLARE_GATEWAY_ARB=
CLOUDFLARE_GATEWAY_BSC=
CLOUDFLARE_GATEWAY_IPFS=

# Fallback: Direct RPC endpoints (used if gateways are not configured)
ETH_RPC_URL=https://rpc.flashbots.net
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BSC_RPC_URL=https://bsc-dataseed.binance.org/rpc

# ── Proxy routing ───────────────────────────────────────────────────────────────
# Canonical names: PROXY_FALLBACK_URL, PROXY_FALLBACK_AUTH_HEADER
# (PROXY_URL is a legacy alias still accepted by the runtime)
PROXY_MODE=auto
PROXY_FALLBACK_URL=
PROXY_FALLBACK_AUTH_HEADER=
DIRECT_EXCHANGES=
# JSON array of proxy objects: [{"url":"...","type":"http","priority":0,"region":"eu"}]
PROXY_LIST=

# ── External proxy (Bright Data / Oxylabs / custom gateway) ─────────────────────
# Canonical names: EXTERNAL_PROXY_FALLBACK_* (legacy aliases: EXTERNAL_PROXY_*)
EXTERNAL_PROXY_FALLBACK_URL=
EXTERNAL_PROXY_FALLBACK_PROVIDER=none
EXTERNAL_PROXY_FALLBACK_USERNAME=
EXTERNAL_PROXY_FALLBACK_PASSWORD=
EXTERNAL_PROXY_FALLBACK_AUTH_HEADER=

# ── Temporal Cloud ──────────────────────────────────────────────────────────────
TEMPORAL_NAMESPACE=default
TEMPORAL_ADDRESS=
TEMPORAL_WORKER_URL=http://localhost:8787
TEMPORAL_API_KEY=

# ── Ecosystem Integrations ──────────────────────────────────────────────────────
HUMMINGBOT_EXECUTE_URL=
HUMMINGBOT_STATUS_URL=
HUMMINGBOT_API_TOKEN=
FREQTRADE_EXECUTE_URL=
FREQTRADE_STATUS_URL=
FREQTRADE_API_TOKEN=
CREWAI_EXECUTE_URL=
CREWAI_STATUS_URL=
CREWAI_API_TOKEN=
AUTOGPT_EXECUTE_URL=
AUTOGPT_STATUS_URL=
AUTOGPT_API_TOKEN=
EXECUTIVE_LOCAL_ADAPTERS=true

# ── Free Data Providers (optional) ──────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# ── Broker Adapters ─────────────────────────────────────────────────────────────
# Supported: alpaca, ibkr, tradier
BROKER_ALPACA_API_KEY=
BROKER_ALPACA_API_SECRET=
BROKER_IBKR_ACCOUNT_ID=
BROKER_IBKR_GATEWAY_URL=
BROKER_TRADIER_API_TOKEN=
BROKER_TRADIER_ACCOUNT_ID=
