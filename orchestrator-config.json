{
  "version": "1.0.0",
  "name": "Universal Orchestrator",
  "description": "Token-efficient primary agent for all platforms",
  "orchestration": {
    "token_budget": 100000,
    "headroom_ratio": 0.2,
    "max_context_tokens": 100000,
    "auto_fallback": true,
    "batch_priority": true
  },
  "agents": {
    "ollama": {
      "type": "local",
      "cost": "free",
      "priority": 1,
      "fallback_to": "codegeex",
      "best_for": [
        "code",
        "general"
      ],
      "endpoint": "http://127.0.0.1:11434",
      "models": [
        "llama2",
        "mistral",
        "neural-chat"
      ]
    },
    "codegeex": {
      "type": "local_or_free_tier",
      "cost": "free",
      "priority": 2,
      "fallback_to": "aimaster",
      "best_for": [
        "code",
        "analysis"
      ],
      "endpoint": "http://127.0.0.1:8000",
      "api_key_env": "CODEGEEX_API_KEY"
    },
    "aimaster": {
      "type": "multi_model",
      "cost": "mixed",
      "priority": 3,
      "fallback_to": "cli",
      "best_for": [
        "analysis",
        "reasoning",
        "critical"
      ],
      "providers": [
        "ollama",
        "deepseek",
        "codegeex",
        "github_copilot"
      ],
      "use_free_only": true
    },
    "hermes": {
      "type": "cloud_agent",
      "cost": "mixed",
      "priority": 3,
      "fallback_to": "omni",
      "best_for": ["long_tasks", "complex_reasoning", "multi_turn", "coding"],
      "endpoint": "https://hermes-agent.nousresearch.com/v1",
      "api_key_env": "HERMES_API_KEY",
      "model_env": "HERMES_MODEL",
      "default_model": "openrouter/auto",
      "use_free_only": true,
      "free_models": [
        "meta-llama/llama-3.1-8b-instruct:free",
        "mistralai/mistral-7b-instruct:free",
        "google/gemma-2-9b-it:free"
      ]
    },
    "omni": {
      "type": "cloud_router",
      "cost": "mixed",
      "priority": 4,
      "fallback_to": "merlin",
      "best_for": ["multi_model", "routing", "general", "analysis"],
      "endpoint": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "default_model": "openrouter/auto",
      "use_free_only": true,
      "free_models": [
        "meta-llama/llama-3.1-8b-instruct:free",
        "mistralai/mistral-7b-instruct:free"
      ]
    },
    "merlin": {
      "type": "cloud_research",
      "cost": "mixed",
      "priority": 5,
      "fallback_to": "aimaster",
      "best_for": ["web_research", "live_search", "browsing", "synthesis"],
      "endpoint": "https://merlin.foyer.work/api/chat",
      "api_key_env": "MERLIN_API_KEY",
      "default_model": "auto"
    },
    "manus": {
      "type": "automation_agent",
      "cost": "free",
      "priority": 6,
      "fallback_to": "cli",
      "best_for": ["browser_automation", "form_filling", "scraping", "clicking"],
      "endpoint": "http://127.0.0.1:8788/api/manus",
      "api_key_env": "MANUS_API_KEY",
      "default_model": "auto"
    },
    "cloudflare": {
      "type": "edge_ai",
      "cost": "free",
      "priority": 7,
      "fallback_to": "ollama",
      "best_for": ["edge_inference", "low_latency", "workers_ai"],
      "endpoint": "${CLOUDFLARE_AI_GATEWAY_URL}",
      "api_key_env": "CLOUDFLARE_API_TOKEN",
      "default_model": "@cf/meta/llama-3.1-8b-instruct",
      "free_models": [
        "@cf/meta/llama-3.1-8b-instruct",
        "@cf/mistral/mistral-7b-instruct-v0.2"
      ]
    },
      "type": "specialized",
      "cost": "free",
      "priority": 4,
      "fallback_to": "aimaster",
      "best_for": [
        "trading",
        "arbitrage"
      ],
      "endpoint": "local_python_module"
    },
    "cli": {
      "type": "local_shell",
      "cost": "free",
      "priority": 5,
      "fallback_to": null,
      "best_for": [
        "command_execution",
        "last_resort"
      ]
    }
  },
  "routing_rules": {
    "code_task": {
      "primary": "codegeex",
      "secondary": [
        "ollama",
        "aimaster"
      ],
      "keywords": [
        "code",
        "function",
        "debug",
        "implement",
        "test"
      ]
    },
    "analysis_task": {
      "primary": "aimaster",
      "secondary": [
        "ollama",
        "codegeex"
      ],
      "keywords": [
        "analyze",
        "report",
        "summary",
        "explain",
        "compare"
      ]
    },
    "trading_task": {
      "primary": "arbitrage",
      "secondary": [
        "aimaster",
        "cli"
      ],
      "keywords": [
        "trade",
        "arbitrage",
        "market",
        "position",
        "order"
      ]
    },
    "research_task": {
      "primary": "merlin",
      "secondary": ["omni", "hermes"],
      "keywords": ["search", "research", "web", "browse", "find", "latest"]
    },
    "automation_task": {
      "primary": "manus",
      "secondary": ["hermes", "cli"],
      "keywords": ["automate", "browser", "click", "form", "scrape"]
    },
    "long_task": {
      "primary": "hermes",
      "secondary": ["omni", "aimaster"],
      "keywords": ["long", "complex", "multi-step", "plan", "refactor"]
    },
    "edge_task": {
      "primary": "cloudflare",
      "secondary": ["ollama", "omni"],
      "keywords": ["edge", "worker", "deploy", "wrangler", "fast"]
    },
      "primary": "ollama",
      "secondary": [
        "codegeex",
        "cli"
      ],
      "threshold_percent": 80
    },
    "budget_critical": {
      "primary": "cli",
      "secondary": [],
      "threshold_percent": 95
    }
  },
  "lean_context": {
    "enabled": true,
    "remove_verbose_logs": true,
    "remove_examples": true,
    "remove_urls": true,
    "collapse_whitespace": true,
    "max_chars": 1000,
    "compression_target": 0.3
  },
  "platforms": {
    "cli": {
      "enabled": true,
      "command": "python3 orchestrator/cli.py"
    },
    "vscode": {
      "enabled": true,
      "extension_id": "orchestrator.universal-agent",
      "port": 3000,
      "mcp_config": ".vscode/mcp.json"
    },
    "web": {
      "enabled": false,
      "api_port": 3001,
      "dashboard_port": 3002
    },
    "github_actions": {
      "enabled": false,
      "action_name": "@orchestrator/run"
    },
    "cloudflare_worker": {
      "enabled": true,
      "endpoint": "hero-super-agent.workers.dev",
      "wrangler_dir": "agents/cloudflare"
    }
  },
  "integrations": {
    "github": {
      "enabled": true,
      "check_token": true,
      "api_endpoint": "https://api.github.com"
    },
    "cloudflare": {
      "enabled": true,
      "check_token": true,
      "api_endpoint": "https://api.cloudflare.com"
    },
    "stripe": {
      "enabled": false,
      "check_token": false
    },
    "arbitrage_exchanges": {
      "enabled": true,
      "exchanges": [
        "binance",
        "kraken",
        "coinbase"
      ]
    }
  },
  "monitoring": {
    "log_level": "info",
    "log_file": "logs/orchestrator.log",
    "health_check_interval_seconds": 60,
    "metrics_enabled": true
  }
}
