{
  "chatTools": {
    "defaultProvider": "hermes",
    "enabled": true,
    "providers": [
      "hermes",
      "coops",
      "ollama",
      "codegeex",
      "openrouter"
    ],
    "autoRoute": true
  },
  "providers": {
    "providers": [
      {
        "id": "hermes",
        "name": "Hermes",
        "type": "external",
        "endpoint": "https://inference-api.nousresearch.com/v1/chat/completions",
        "apiKey": "${env:NousAI_API_KEY}"
      },
      {
        "id": "coops",
        "name": "COOPS",
        "type": "local",
        "command": "python3 cooperation/coops_desktop_agent.py"
      },
      {
        "id": "ollama",
        "name": "Ollama",
        "type": "local",
        "endpoint": "http://127.0.0.1:11434"
      },
      {
        "id": "codegeex",
        "name": "CodeGeeX",
        "type": "local",
        "endpoint": "http://127.0.0.1:8000"
      },
      {
        "id": "openrouter",
        "name": "OpenRouter",
        "type": "external",
        "endpoint": "https://openrouter.ai/api/v1"
      }
    ]
  },
  "copilotIntegration": {
    "enabled": true,
    "autoDelegate": true,
    "delegateKeywords": [
      "build",
      "test",
      "deploy",
      "optimize",
      "analyze",
      "fix bug",
      "create",
      "implement"
    ]
  }
}