export default {
    async scheduled(event, env, ctx) { if (botRunning) await runCycle(env); },
    async fetch(request, env, ctx) {
        const saved = await env.BOT_STATE.get('bot_state', 'json');
        if (saved) botState = { ...botState, ...saved };
        const url = new URL(request.url);
        if (url.pathname === '/' || url.pathname === '/dashboard') return new Response(renderDashboard(botState), { headers: { 'Content-Type': 'text/html; charset=UTF-8' } });
        if (url.pathname === '/control' && request.method === 'POST') { const body = await request.text(); botRunning = (body === 'start'); return new Response("OK"); }
        return new Response("استخدم /dashboard");
    }
};
