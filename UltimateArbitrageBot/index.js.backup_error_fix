// ---------- دوال مساعدة ----------
/**
 * جلب سعر BTC/USDT من Binance
 */
async function getBinancePrice() {
    const res = await fetch('https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT');
    if (!res.ok) throw new Error(Binance API error: );
    const data = await res.json();
    return parseFloat(data.price);
}

/**
 * جلب أفضل سعر شراء (Ask) من Kraken لزوج BTC/USDT
 */
async function getKrakenAskPrice() {
    const res = await fetch('https://api.kraken.com/0/public/Ticker?pair=XBTUSDT');
    if (!res.ok) throw new Error(Kraken API error: );
    const data = await res.json();
    // في Kraken، أول عنصر في المصفوفة "a" هو سعر الطلب (ask)
    const ask = data.result.XBTUSDT.a[0];
    return parseFloat(ask);
}

/**
 * إرسال رسالة إلى تيليجرام
 */
async function sendTelegramMessage(botToken, chatId, text) {
    const url = https://api.telegram.org/bot/sendMessage;
    const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            chat_id: chatId,
            text: text,
            parse_mode: 'HTML'
        })
    });
    if (!res.ok) {
        const errText = await res.text();
        throw new Error(Telegram send failed:  - );
    }
    return res.json();
}

