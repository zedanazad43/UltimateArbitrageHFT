# Local development environment variables template
# Copy this to .env.local and fill in your actual keys
# WARNING: NEVER commit .env.local to version control

# Admin authentication
ADMIN_TOKEN=dev-only-secret-change-in-production

# Paper/Live trading modes
PAPER_TRADING=true
TRADING_ENABLED=false

# Go HFT Engine secrets
HFT_ENGINE_SECRET=dev-hft-engine-secret

# Exchange API credentials (OPTIONAL — leave blank to skip exchange)
MEXC_API_KEY=
MEXC_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_SECRET_KEY=
KUCOIN_PASSPHRASE=
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_API_PASSPHRASE=
BITMART_API_KEY=
BITMART_SECRET_KEY=
BITMART_MEMO=

# Telegram bot (OPTIONAL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Blockchain RPC endpoints
ALCHEMY_API_KEY=
ETH_RPC_URL=https://rpc.flashbots.net
ARBITRUM_RPC_URL=

# Temporal Cloud (OPTIONAL)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# PostgreSQL
POSTGRES_PASSWORD=arbitrage-dev-pass

# Development flags
NODE_ENV=production
SCAN_INTERVAL_MS=500
MIN_NET_PROFIT_PCT=0.05
MAX_SPREAD_PCT=5.0
INITIAL_CAPITAL_USD=1000
MAX_DAILY_LOSS_USD=25
MIN_SECONDS_BETWEEN_TX=30
WIN_RATE=0.55
RISK_REWARD_RATIO=2.0
MAX_GAS_COST_PCT=0.30
