# .env.local — Local CodeGeeX / AI Backend Configuration
# Copy this file to .env.local and uncomment to enable.
# Full variable reference: see docs/env-reference.md (section 4)

# AI Backend: choose "local" for CodeGeeX or "cloudflare" for Workers AI
AI_BACKEND=local

# Local CodeGeeX Server Endpoint (if using local backend)
LOCAL_AI_ENDPOINT=http://localhost:8000

# Timeout for local AI requests in ms (CPU inference can be slow; default 15000)
# LOCAL_AI_TIMEOUT_MS=15000

# Model-specific settings (optional)
# MODEL_NAME=THUDM/codegeex4-all-9b    # Default (9B model)
# MODEL_NAME=THUDM/codegeex4-all-1b    # Smaller/faster alternative (1B model)

# Server port (if you need to change from default 8000)
# CODEGEEX_PORT=8000
