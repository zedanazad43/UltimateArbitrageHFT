# .env.local — Local development configuration
# Copy this file to .env.local and uncomment/fill values

# ── AI Backend ────────────────────────────────────────────────────────────────
# choose "local", "cloudflare", "openrouter", or "hermes"
AI_BACKEND=local

# ── Local CodeGeeX / Ollama ───────────────────────────────────────────────────
LOCAL_AI_ENDPOINT=http://localhost:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
# MODEL_NAME=THUDM/codegeex4-all-9b
# MODEL_NAME=THUDM/codegeex4-all-1b
# CODEGEEX_PORT=8000

# ── OpenRouter (free tier available) ─────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/auto

# ── Hermes Agent ─────────────────────────────────────────────────────────────
HERMES_API_KEY=
HERMES_MODEL=openrouter/auto

# ── Merlin Research Agent ─────────────────────────────────────────────────────
MERLIN_API_KEY=

# ── Cloudflare AI Gateway ─────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/${CLOUDFLARE_ACCOUNT_ID}/ultimatearbitragehft

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_BASE_URL=https://ultimatearbitragehft.zedanazad43.workers.dev
WORKER_ADMIN_TOKEN=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
