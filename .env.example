# UltimateArbitrageHFT — Environment Reference (NO secrets, safe to commit)
# Copy to .env and fill values locally.

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=
WORKFLOW_ADMIN_TOKEN=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloudflare bindings (auto from wrangler.toml) ───────────────────────────
# BOT_STATE, KV_STORAGE, DB, MY_D1, MARKET_STREAMER, HFT_BACKUP,
# ANALYTICS, TRADE_LOGS, R2, AIWORKER, TRADE_QUEUE, ULTIMATEARBITRAGEQUEUE

# ── Free Web3 alternatives (pick one per chain) ───────────────────────────
# Alchemy: https://www.alchemy.com/ (300M calls/mo free)
ALCHEMY_API_KEY=
ALCHEMY_ETHEREUM_RPC=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Infura: https://infura.io/ (100K req/day free)
INFURA_API_KEY=
INFURA_ETHEREUM_RPC=https://mainnet.infura.io/v3/${INFURA_API_KEY}

# Moralis: https://moralis.io/ (free tier)
MORALIS_API_KEY=
MORALIS_ETHEREUM_RPC=https://eth-mainnet.moralis.io/v2/${MORALIS_API_KEY}

# QuickNode: https://www.quicknode.com/ (free tier)
QUICKNODE_API_KEY=
QUICKNODE_ETHEREUM_RPC=https://your-endpoint.quiknode.pro/${QUICKNODE_API_KEY}/

# ── Exchange credentials (set via wrangler secret put) ──────────────────────
# BINANCE_API_KEY, BINANCE_API_SECRET
# BITGET_API_KEY, BITGET_API_SECRET, BITGET_PASSPHRASE
# BITMART_API_KEY, BITMART_API_SECRET, BITMART_MEMO
# HTX_API_KEY, HTX_API_SECRET
# KUCOIN_API_KEY, KUCOIN_API_SECRET, KUCOIN_PASSPHRASE
# MEXC_API_KEY, MEXC_API_SECRET
# BYBIT_API_KEY, BYBIT_API_SECRET
# GATEIO_API_KEY, GATEIO_API_SECRET

# ── Proxy (optional, free via local gateway + serveo tunnel) ────────────────
PROXY_MODE=auto
PROXY_URL_1=
PROXY_AUTH_HEADER=X-Gateway-Token:

# ── External proxy (optional) ──────────────────────────────────────────────
EXTERNAL_PROXY_URL=

# OpenAI/Anthropic LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Merlin AI API
MERLIN_API_KEY=
MERLIN_API_URL=https://endpoints.getmerlin.in/chat/completions
