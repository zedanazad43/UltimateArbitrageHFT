# UltimateArbitrageHFT — Environment Reference (NO secrets, safe to commit)
# Copy to .env and fill values locally.

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=
WORKFLOW_ADMIN_TOKEN=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloudflare bindings (auto from wrangler.toml) ───────────────────────────
# BOT_STATE, KV_STORAGE, DB, MY_D1, MARKET_STREAMER, HFT_BACKUP,
# ANALYTICS, TRADE_LOGS, R2, AIWORKER, TRADE_QUEUE, ULTIMATEARBITRAGEQUEUE

# ── Free Web3 alternatives (pick one per chain) ───────────────────────────
# Alchemy: https://www.alchemy.com/ (300M calls/mo free)
ALCHEMY_API_KEY=
ALCHEMY_ETHEREUM_RPC=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Infura: https://infura.io/ (100K req/day free)
INFURA_API_KEY=
INFURA_ETHEREUM_RPC=https://mainnet.infura.io/v3/${INFURA_API_KEY}

# Moralis: https://moralis.io/ (free tier)
MORALIS_API_KEY=
MORALIS_ETHEREUM_RPC=https://eth-mainnet.moralis.io/v2/${MORALIS_API_KEY}

# QuickNode: https://www.quicknode.com/ (free tier)
QUICKNODE_API_KEY=
QUICKNODE_ETHEREUM_RPC=https://your-endpoint.quiknode.pro/${QUICKNODE_API_KEY}/

# ── Exchange credentials (set via wrangler secret put) ──────────────────────
# BINANCE_API_KEY, BINANCE_API_SECRET
# BITGET_API_KEY, BITGET_API_SECRET, BITGET_PASSPHRASE
# BITMART_API_KEY, BITMART_API_SECRET, BITMART_MEMO
# HTX_API_KEY, HTX_API_SECRET
# KUCOIN_API_KEY, KUCOIN_API_SECRET, KUCOIN_PASSPHRASE
# MEXC_API_KEY, MEXC_API_SECRET
# BYBIT_API_KEY, BYBIT_API_SECRET
# GATEIO_API_KEY, GATEIO_API_SECRET

# ── Proxy (optional, free via local gateway + serveo tunnel) ────────────────
PROXY_MODE=auto
PROXY_URL_1=
PROXY_AUTH_HEADER=X-Gateway-Token:

# ── External proxy (optional) ──────────────────────────────────────────────
EXTERNAL_PROXY_URL=

# Bitsgap / Kryll backtesting integrations
BITSGAP_API_KEY=
BITSGAP_API_URL=https://api.bitsgap.com/v1
KRYLL_API_KEY=
KRYLL_API_URL=https://api.kryll.io/v1

# OpenAI/Anthropic LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Merlin AI API
MERLIN_API_KEY=
MERLIN_API_URL=https://endpoints.getmerlin.in/chat/completions

# Cloudflare Managed Services (SaaS)
D1_DATABASE_ID=your-d1-db-id
R2_BUCKET_NAME=your-r2-bucket
VECTORIZE_INDEX_NAME=your-vectorize-index
CF_AI_MODEL=llama-3.1-8b-instruct

# Free-tier Cloudflare services (no payment needed)
# Workers AI: daily free limits
# D1: 5GB / 5M reads
# R2: 10GB / 10M reads
FREE_TIER_SERVICES=workers-ai,d1,kv,r2

# ── Multi-Agent Cooperation Stack ────────────────────────────────────────────

# OpenRouter / OmniRoute (free tier available at https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/auto

# Hermes Agent (Nous Research)
HERMES_API_KEY=
HERMES_MODEL=openrouter/auto
HERMES_BASE_URL=https://hermes-agent.nousresearch.com/v1

# Merlin AI
MERLIN_API_KEY=

# Manus Agent (local or cloud)
MANUS_API_KEY=
MANUS_ENDPOINT=http://127.0.0.1:8788/api/manus

# Cloudflare Workers AI Gateway
# Get from: Cloudflare Dashboard → AI → AI Gateway → your gateway URL
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_API_TOKEN=
WORKER_AUTH_TOKEN=
DEFAULT_CF_MODEL=@cf/meta/llama-3.1-8b-instruct
