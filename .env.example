# Example environment variables (no real secrets) — copy to .env and fill in values

# ── Cloudflare ──────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/${CLOUDFLARE_ACCOUNT_ID}/ultimatearbitragehft

# ── Cloudflare Worker (UltimateArbitrageHFT) ────────────────────────────────
WORKER_BASE_URL=https://ultimatearbitragehft.zedanazad43.workers.dev
WORKER_ADMIN_TOKEN=

# ── AI Agents ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
HERMES_API_KEY=
HERMES_MODEL=openrouter/auto
MERLIN_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading Exchanges ─────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ── Local AI (Ollama / CodeGeeX) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
CODEGEEX_API_KEY=
LOCAL_AI_ENDPOINT=http://localhost:8000

# ── Railway ───────────────────────────────────────────────────────────────────
RAILWAY_TOKEN=
