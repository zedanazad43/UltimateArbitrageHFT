{
  "name": "coops-desktop",
  "displayName": "COOPS Desktop Agent",
  "description": "Full cooperation agent with desktop, CLI, VS Code, and cloud integrations",
  "type": "desktop",
  "commands": {
    "default": "python3 cooperation/lean_ctx_coops.py",
    "init": "python3 cooperation/integrate_all.py",
    "status": "python3 -c \"from cooperation.lean_ctx_coops import lean_ctx; import json; print(json.dumps(lean_ctx.get_summary(), indent=2))\"",
    "tasks": "python3 -c \"from cooperation.lean_ctx_coops import lean_ctx; import json; print(json.dumps(lean_ctx.get_tasks(), indent=2))\"",
    "balances": "python3 -c \"from cooperation.lean_ctx_coops import lean_ctx; import json; print(json.dumps(lean_ctx.balances, indent=2))\"",
    "tokens": "python3 -c \"from cooperation.lean_ctx_coops import lean_ctx; import json; print(json.dumps(lean_ctx.tokens, indent=2))\"",
    "route": "python3 -c \"from cooperation.lean_ctx_coops import lean_ctx; import json; print(json.dumps(lean_ctx.MODEL_ROUTING, indent=2))\"",
    "memory": "python3 -c \"from cooperation.lean_ctx_coops import lean_ctx; import json; print(json.dumps(lean_ctx.context, indent=2))\"",
    "metrics": "python3 -c \"from cooperation.lean_ctx_coops import lean_ctx; import json; print(json.dumps(lean_ctx.metrics, indent=2))\"",
    "help": "python3 -c \"from cooperation.lean_ctx_coops import lean_ctx; print('Available commands: init, status, tasks, balances, tokens, route, memory, metrics, help')\""
  },
  "providers": {
    "local": {
      "ollama": {
        "endpoint": "http://127.0.0.1:11434",
        "models": ["llama2", "mistral", "neural-chat", "codellama"],
        "priority": 1,
        "type": "local"
      },
      "codegeex": {
        "endpoint": "http://127.0.0.1:8000",
        "models": ["codegeex4", "codegeex4-all-9b"],
        "priority": 2,
        "type": "local"
      }
    },
    "cloud": {
      "bytez": {
        "endpoint": "https://api.bytez.com/models/v2",
        "apiKeySecret": "BYTEZ_API_KEY",
        "models": [
          "meta-llama/Llama-3.2-1B-Instruct",
          "Qwen/Qwen2.5-Coder-32B-Instruct",
          "mistralai/Mistral-7B-Instruct-v0.3",
          "microsoft/phi-4",
          "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B"
        ],
        "priority": 2,
        "type": "cloud"
      },
      "huggingface": {
        "endpoint": "https://api-inference.huggingface.co/models",
        "models": ["moonshot/kimi-v1-adapter", "openchat/OpenChat-3.5-7B"],
        "priority": 3,
        "type": "free"
      },
      "openrouter": {
        "endpoint": "https://openrouter.ai/api/v1",
        "models": ["meta/llama-3.1-8b-instruct", "qwen/qwen2.5-coder-32b-instruct", "google/gemini-2.0-flash"],
        "priority": 4,
        "type": "free"
      },
      "omniroute": {
        "endpoint": "http://127.0.0.1:20128",
        "models": ["hermes", "copilot", "manus", "merlin"],
        "priority": 5,
        "type": "local-gateway"
      },
      "merlin": {
        "endpoint": "https://endpoints.getmerlin.in/chat/completions",
        "models": ["merlin-ai"],
        "priority": 6,
        "type": "free"
      },
      "manus": {
        "endpoint": "https://manus.app/api",
        "models": ["manus-agent"],
        "priority": 7,
        "type": "cloud"
      }
    }
  },
  "modelRouting": {
    "primary": "local",
    "secondary": ["cloud.bytez", "cloud.huggingface", "cloud.openrouter"],
    "fallback": ["local.ollama", "local.codegeex"],
    "freeOnly": false,
    "paperMode": true
  },
  "tools": {
    "terminal": true,
    "filesystem": true,
    "github": true,
    "cloudflare": true,
    "web": true,
    "browser": true,
    "ai": true,
    "memory": true
  },
  "skills": {
    "code": ["bytez", "ollama", "codegeex", "copilot"],
    "analysis": ["bytez", "aimaster", "ollama", "huggingface"],
    "trading": ["bytez", "arbitrage", "manus", "merlin"],
    "build": ["codegeex", "ollama", "cli"],
    "test": ["cli", "ollama"],
    "deploy": ["wrangler", "cli", "omniroute"],
    "research": ["bytez", "huggingface", "openrouter", "manus"],
    "planning": ["bytez", "hermes", "copilot", "manus"]
  },
  "memory": {
    "local": "C:/Users/azadz/AppData/Local/hermes/coops_memory",
    "persistent": true,
    "cache": true,
    "compression": "lean-ctx"
  },
  "contextPaths": [
    ".github/copilot-instructions.md",
    ".cursor/rules/lean-ctx.mdc",
    "cooperation/PLAN.md"
  ]
}