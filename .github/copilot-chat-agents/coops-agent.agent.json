{
  "name": "coops-agent",
  "displayName": "COOPS Agent",
  "description": "Full cooperation agent with desktop, CLI, VS Code, and cloud integrations",
  "type": "copilot",
  "commands": {
    "status": {
      "title": "Show COOPS Status",
      "description": "Display COOPS agent status and memory summary",
      "command": "python3 cooperation/coops_desktop_agent.py status"
    },
    "tasks": {
      "title": "List COOPS Tasks",
      "description": "List all tracked tasks",
      "command": "python3 cooperation/coops_desktop_agent.py tasks"
    },
    "balances": {
      "title": "Show Exchange Balances",
      "description": "Display exchange balances",
      "command": "python3 cooperation/coops_desktop_agent.py balances"
    },
    "tokens": {
      "title": "Show Token Catalog",
      "description": "Display token definitions",
      "command": "python3 cooperation/coops_desktop_agent.py tokens"
    },
    "route": {
      "title": "Show Model Routing",
      "description": "Display model routing configuration",
      "command": "python3 cooperation/coops_desktop_agent.py route"
    },
    "init": {
      "title": "Initialize COOPS Memory",
      "description": "Initialize COOPS memory system",
      "command": "python3 cooperation/lean_ctx_coops.py"
    },
    "deploy": {
      "title": "Deploy to Cloudflare Workers",
      "description": "Deploy current configuration to Cloudflare Workers",
      "command": "node wrangler.mjs deploy"
    },
    "whoami": {
      "title": "Show System Identity",
      "description": "Display system identity and environment info",
      "command": "node wohami.mjs whoami"
    }
  },
  "skills": [
    {
      "id": "code-analysis",
      "name": "Code Analysis",
      "description": "Analyze, debug, and optimize code",
      "providers": ["bytez", "codegeex", "ollama"]
    },
    {
      "id": "trade-analysis",
      "name": "Trade Analysis",
      "description": "Analyze trading opportunities and performance",
      "providers": ["bytez", "aimaster", "ollama"]
    },
    {
      "id": "deployment",
      "name": "Deployment",
      "description": "Deploy and manage cloud infrastructure"
    },
    {
      "id": "memory-management",
      "name": "Memory Management",
      "description": "Manage persistent context and memory"
    },
    {
      "id": "bytez-inference",
      "name": "Bytez Inference",
      "description": "Run LLM inference via Bytez cloud API using BYTEZ_API_KEY secret",
      "providers": ["bytez"]
    }
  ],
  "providers": {
    "primary": "ollama",
    "secondary": ["codegeex", "aimaster", "bytez"],
    "fallback": ["cli"],
    "bytez": {
      "endpoint": "https://api.bytez.com/models/v2",
      "apiKeySecret": "BYTEZ_API_KEY",
      "models": [
        "meta-llama/Llama-3.2-1B-Instruct",
        "Qwen/Qwen2.5-Coder-32B-Instruct",
        "mistralai/Mistral-7B-Instruct-v0.3"
      ],
      "priority": 3,
      "type": "cloud"
    }
  }
}